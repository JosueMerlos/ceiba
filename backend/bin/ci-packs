#!/usr/bin/env bash
# CI backend-packs job (and bin/ci): boundaries between packs. Run from backend/. `packwerk validate` checks the
# configuration and the package.yml files; `packwerk check` fails on any dependency, privacy or layer violation not in
# a package_todo.yml (and the package_todo.yml growth check prevents registering new ones). Loads Rails (autoload
# paths) but needs neither a database nor Redis.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=test
bundle exec packwerk validate
bundle exec packwerk check
