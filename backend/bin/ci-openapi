#!/usr/bin/env bash
# "contract" step of the CI api-contract job (and bin/ci): regenerates openapi/v1.yaml from the rswag specs. Run from
# backend/. Needs PostgreSQL with the roles (like ci-test): rails_helper checks the schema.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=test

bin/rails db:prepare
bin/rails openapi:generate
