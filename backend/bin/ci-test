#!/usr/bin/env bash
# CI backend-test job (and bin/ci): prepares the test database and runs RSpec.
# Needs PostgreSQL and Redis reachable (DB_HOST, POSTGRES_*, REDIS_URL).
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=test
export CI=true # eager_load on: catches load errors that lazy mode hides

bin/rails db:prepare
bundle exec rspec
