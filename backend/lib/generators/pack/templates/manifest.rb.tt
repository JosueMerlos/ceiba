# Manifest of module <%= pack_name %>. The platform/modules registry loads it by FILE at boot and validates it: the key
# must match the pack name and can never change.
# Only strings and data here (no constants from another pack: this file is excluded from packwerk).
#
# Available fields; uncomment and fill in the ones the module needs:
#
#   permissions do
#     permission "<%= pack_name %>.<resource>.<action>", description: "What it allows"   # the prefix is the module key
#   end
#   role_grants do                                    # default template for the system roles
#     grant :company_manager, all: true
#     grant :receptionist, %w[<%= pack_name %>.<resource>.read]
#   end
#   api_scopes  "read:<%= pack_name %>" => %w[<%= pack_name %>.<resource>.read]
#   settings_schema "config/settings.schema.json"     # JSON Schema; every property carries a `default`
#   settings_levels %i[company branch]
#   publishes   %w[<%= pack_name %>.<event>.v1]        # each event needs its schema in app/public/<%= pack_name %>/events/
#   subscribes  { "other.event.v1" => "<%= namespace %>::Subscribers::Something" }
#   navigation  [ { key: "home", path: "/<%= pack_name %>", permission: "<%= pack_name %>.<resource>.read" } ]
#   on_enable   "<%= namespace %>::Lifecycle::OnEnable"    # resolved with constantize when run
#   on_disable  "<%= namespace %>::Lifecycle::OnDisable"
Modules.define :<%= pack_name %> do
  name        "<%= namespace %>"   # human-readable name, e.g. "Loyalty"
  version     "1.0"
  requires    []                   # other modules that must be active in the company
  platform    []                   # platform capabilities it uses (customers, notifications...)
end
