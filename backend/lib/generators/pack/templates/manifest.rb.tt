# Manifiesto del módulo <%= pack_name %>. PLACEHOLDER (M0.03): el DSL `Modules.define`, sus campos y su
# validación llegan con M0.09 (docs/architecture/05-module-system.md). Se rellena entonces:
#
#   Modules.define :<%= pack_name %> do
#     name        ""
#     version     "1.0"
#     requires    []
#     platform    []
#     permissions { }
#     publishes   []
#     subscribes  {}
#   end
