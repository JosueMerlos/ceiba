# Pack <%= layer %>/<%= pack_name %> (namespace <%= namespace %>).
layer: <%= layer %>
enforce_dependencies: true
enforce_privacy: true
enforce_layers: true
<% if modules_layer? -%>
# No other pack may use this module (visibility): modules talk to each other only through events.
# The layer checker allows dependencies within the same layer, hence this.
enforce_visibility: true
visible_to: []
<% end -%>

# Declare ONLY what the pack uses here. "." is the root pack (ApplicationRecord, ApplicationController...).
<% if modules_layer? -%>
# A module depends on platform/ packs, never on another module (modules talk through events).
<% else -%>
# A platform pack depends on no module.
<% end -%>
dependencies:
  - "."
