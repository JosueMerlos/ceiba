source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.4", ">= 8.1.4.1"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Background jobs run on Sidekiq; Solid Queue is not used.
gem "sidekiq", "~> 8.1"
# Domain events and outbox: second-level cron for the relay, and JSON Schema payload validation.
gem "sidekiq-cron", "2.4.0"
gem "json_schemer", "2.5.0"
# Per-organization feature flags: they roll out NEW functionality and do not replace module activation.
gem "flipper", "1.4.2"
# require: false because loading it defines Active Record models, which would load ActiveRecord::Base before the
# encryption config; it is required from the platform/modules initializer.
gem "flipper-active_record", "1.4.2", require: false

# Modular monolith: pack boundaries are enforced by tooling.
gem "packwerk", "3.3.1"
gem "packwerk-extensions", "0.4.0"
gem "packs-rails", "0.1.1"

# Database conventions: dangerous migrations are blocked, plus es-NI translations.
gem "strong_migrations", "2.8.0"
gem "rails-i18n", "8.1.0"

# Multi-tenancy: the tenant is the organization. Pinned version.
gem "acts_as_tenant", "2.2.2"

# API contract: Alba serializers and OpenAPI docs served by rswag. Pinned versions.
gem "alba", "4.0.3"
gem "rswag-api", "2.17.0"
gem "rswag-ui", "2.17.0"

# Phone parsing and E.164 normalization (customers). Pinned version.
gem "phonelib", "0.10.28"
# rswag-ui still uses ostruct, which stops being a default gem in Ruby 4.0 (warns on every boot).
gem "ostruct", "0.6.3"

# Identity and sessions: has_secure_password uses bcrypt. Pinned version.
gem "bcrypt", "3.1.22"

# Access control: Pundit with one policy per model inside its pack. Pinned version.
gem "pundit", "2.5.2"

# Baseline observability and security. Pinned versions.
# One-line structured request logs (lograge).
gem "lograge", "0.15.1"
# Errors to Sentry: Rails (including Rails.error), Sidekiq and the base SDK. Inactive without a DSN.
gem "sentry-ruby", "7.2.0"
gem "sentry-rails", "7.2.0"
gem "sentry-sidekiq", "7.2.0"
# Layer-1 rate limiting; mounted by hand in the throttling initializer, after RemoteIp.
gem "rack-attack", "6.8.0", require: false
# Rack::Attack store: ActiveSupport::Cache::RedisCacheStore needs the redis gem (Sidekiq uses redis-client).
gem "redis", "6.0.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]


group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # RSpec replaces minitest; FactoryBot provides test data.
  gem "rspec-rails", "~> 8.1"
  gem "factory_bot_rails", "~> 6.5"
  # rswag specs generate openapi/v1.yaml and validate every response against the contract.
  gem "rswag-specs", "2.17.0"

  # Static quality and security checks.
  gem "rubocop-rails-omakase", "~> 1.1", require: false
  gem "rubocop-rails", "~> 2.38", require: false
  gem "rubocop-rspec", "~> 3.10", require: false
  gem "rubocop-factory_bot", "~> 2.28", require: false
  gem "brakeman", "~> 8.1", require: false
  gem "bundler-audit", "~> 0.9", require: false
end
