source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.4", ">= 8.1.4.1"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Jobs en segundo plano (ADR-0009). Solid Queue no se usa.
gem "sidekiq", "~> 8.1"
# Eventos de dominio y outbox (M0.10): cron de segundos para el relay y validación de payloads por JSON Schema.
gem "sidekiq-cron", "2.4.0"
gem "json_schemer", "2.5.0"

# Monolito modular (ADR-0001, M0.03): límites entre packs verificados por herramienta.
gem "packwerk", "3.3.1"
gem "packwerk-extensions", "0.4.0"
gem "packs-rails", "0.1.1"

# Convenciones de base de datos (M0.04): migraciones peligrosas bloqueadas y traducciones es-NI.
gem "strong_migrations", "2.8.0"
gem "rails-i18n", "8.1.0"

# Multi-tenancy (M0.05): el tenant es la organización (ADR-0003). Versión fijada.
gem "acts_as_tenant", "2.2.2"

# Contrato API (M0.06, ADR-0012): serializers con Alba y documentación OpenAPI servida por rswag. Versiones fijadas.
gem "alba", "4.0.3"
gem "rswag-api", "2.17.0"
gem "rswag-ui", "2.17.0"
# rswag-ui aún usa ostruct, que deja de ser gema por defecto en Ruby 4.0 (avisa en cada arranque).
gem "ostruct", "0.6.3"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]


group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Tests (M0.02): RSpec reemplaza a minitest; FactoryBot para los datos de prueba.
  gem "rspec-rails", "~> 8.1"
  gem "factory_bot_rails", "~> 6.5"
  # Los specs de rswag generan openapi/v1.yaml y validan cada respuesta contra el contrato (M0.06).
  gem "rswag-specs", "2.17.0"

  # Calidad y seguridad estáticas (M0.02).
  # Estilo base de Rails 8 (omakase) + reglas de Rails y RSpec encima. Ver .rubocop.yml.
  gem "rubocop-rails-omakase", "~> 1.1", require: false
  gem "rubocop-rails", "~> 2.38", require: false
  gem "rubocop-rspec", "~> 3.10", require: false
  gem "rubocop-factory_bot", "~> 2.28", require: false
  gem "brakeman", "~> 8.1", require: false
  gem "bundler-audit", "~> 0.9", require: false
end
