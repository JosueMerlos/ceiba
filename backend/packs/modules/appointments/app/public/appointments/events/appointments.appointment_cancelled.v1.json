{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appointments.appointment_cancelled.v1",
  "description": "Se canceló una cita: quién y por qué, como códigos (sin texto libre). Solo ids, estados y horas: sin notas ni datos del cliente. La organización viaja en el sobre del evento.",
  "type": "object",
  "required": [
    "appointment_id",
    "branch_id",
    "professional_id",
    "customer_id",
    "starts_at",
    "ends_at",
    "from_status",
    "cancelled_by",
    "cancellation_reason"
  ],
  "properties": {
    "appointment_id": {
      "type": "string",
      "format": "uuid"
    },
    "branch_id": {
      "type": "string",
      "format": "uuid"
    },
    "professional_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_status": {
      "enum": [
        "scheduled",
        "confirmed"
      ]
    },
    "cancelled_by": {
      "enum": [
        "staff",
        "customer",
        "system"
      ]
    },
    "cancellation_reason": {
      "enum": [
        "customer_request",
        "professional_unavailable",
        "business_decision",
        "other"
      ]
    }
  },
  "additionalProperties": false
}
