# Copy this file to .env (optional: compose.yaml already includes these default values).
# DEVELOPMENT values ​​only: there are no—and should not be any—actual secrets here.

# Ports published on the host
PROXY_PORT=8080
MAILPIT_PORT=8025

# UID/GID del host (make up los rellena con id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# PostgreSQL
POSTGRES_USER=ceiba
POSTGRES_PASSWORD=ceiba_dev_password
POSTGRES_DB=ceiba_development

APP_OWNER_PASSWORD=ultra_secret_owner_password
APP_USER_PASSWORD=ultra_secret_user_password

# Rails
RAILS_ENV=development
