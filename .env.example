# Copia este archivo a .env (opcional: compose.yaml ya trae estos valores por defecto).
# Solo valores de DESARROLLO: aquí no hay ni debe haber ningún secreto real.

# Puertos publicados en el host
PROXY_PORT=8080
MAILPIT_PORT=8025

# UID/GID del host (make up los rellena con id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# PostgreSQL
POSTGRES_USER=ceiba
POSTGRES_PASSWORD=ceiba_dev_password
POSTGRES_DB=ceiba_development

# Redis
REDIS_URL=redis://redis:6379/0

# Rails
RAILS_ENV=development
