{
  "name": "ceiba-frontend",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "api:generate": "pnpm --filter @ceiba/api-client generate"
  },
  "devDependencies": {
    "@ceiba/config": "workspace:*",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
