#!/usr/bin/env bash
# Bundle budgets: builds booking and panel and requires each one's CRITICAL JS (entry + static imports, excluding
# on-demand chunks) to stay under its gzip limit. Limits live in bundle-budgets.json (a SINGLE source; tests do not
# repeat them). Runs from frontend/.
#   booking 150 KiB (mobile on 3G; raising it is a deliberate decision)
#   panel   220 KiB (measured 198.5 KiB + ~10 % margin; the panel is not mobile-first)
# Measures JS only (CSS and fonts do not count here).
set -euo pipefail
cd "$(dirname "$0")/.."

pnpm install --frozen-lockfile --prefer-offline
pnpm --filter @ceiba/booking build
pnpm --filter @ceiba/panel build
node packages/config/bundle-budget.mjs bundle-budgets.json
