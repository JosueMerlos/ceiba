#!/usr/bin/env bash
# Job frontend-security de CI (y de bin/ci): dependencias con vulnerabilidades de nivel alto o crítico.
# Los ignorados, si hicieran falta, van con fecha de revisión y motivo (ver docs/architecture/12-testing-strategy.md).
set -euo pipefail
cd "$(dirname "$0")/.."

pnpm install --frozen-lockfile --prefer-offline
pnpm audit --audit-level=high
