# Proxy de desarrollo: UN solo origen (http://localhost:PROXY_PORT, 8080 por defecto) para API, panel y booking.
# Misma regla de enrutamiento que producción (ADR-0013). El prefijo NO se quita:
# Rails monta sus rutas bajo /api y Vite sirve booking bajo la base /c/.
{
	admin off
	auto_https off
}

:{$PROXY_PORT:8080} {
	handle /__proxy/health {
		respond "ok" 200
	}

	# `path /api /api/*`: también /api sin barra final va a la API, no al panel
	@api path /api /api/*
	# Cabeceras con las que un cliente podría declarar otra IP: no deben llegar a la API (que solo lee X-Forwarded-For, que
	# Caddy sobrescribe con la IP del cliente). La app también las descarta (NetworkTrust::UntrustedForwardingFilter).
	handle @api {
		reverse_proxy api:3000 {
			header_up -Forwarded
			header_up -Client-Ip
			header_up -X-Real-Ip
		}
	}

	# /c sin barra final -> /c/ (la base de Vite)
	redir /c /c/ 308

	# Incluye el websocket de HMR de Vite: Caddy hace el upgrade automáticamente.
	handle /c/* {
		reverse_proxy booking:5174
	}

	# CSP inicial del panel en MODO REPORTE (M0.13): no bloquea nada, la consola del navegador lista las violaciones.
	# Vite en desarrollo inyecta scripts en línea (preámbulo de react-refresh) y usa websockets: esperables aquí.
	# Se endurece (sin 'unsafe-inline', con nonces o hashes) y se pasa a Content-Security-Policy cuando exista el
	# build de producción (M4.04). `connect-src` incluye el ingest de Sentry: ajústalo al host de tu DSN.
	handle {
		header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss: https://*.ingest.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy panel:5173
	}
}
