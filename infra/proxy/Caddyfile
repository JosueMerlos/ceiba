# Development proxy: a SINGLE origin (http://localhost:PROXY_PORT, 8080 by default) for API, panel and booking.
# Same routing rule as production. The prefix is NOT stripped: Rails mounts its routes under /api and Vite serves
# booking under the /c/ base.
{
	admin off
	auto_https off
}

:{$PROXY_PORT:8080} {
	handle /__proxy/health {
		respond "ok" 200
	}

	# `path /api /api/*`: /api without a trailing slash also goes to the API, not the panel
	@api path /api /api/*
	# Headers a client could use to claim another IP must not reach the API (it only reads X-Forwarded-For, which Caddy
	# overwrites with the client IP). The app drops them too (NetworkTrust::UntrustedForwardingFilter).
	handle @api {
		reverse_proxy api:3000 {
			header_up -Forwarded
			header_up -Client-Ip
			header_up -X-Real-Ip
		}
	}

	# /c without a trailing slash -> /c/ (Vite's base)
	redir /c /c/ 308

	# Includes Vite's HMR websocket: Caddy upgrades the connection automatically.
	handle /c/* {
		reverse_proxy booking:5174
	}

	# Panel CSP in REPORT-ONLY mode: blocks nothing, the browser console lists violations. Vite in development injects
	# inline scripts (react-refresh preamble) and uses websockets, so those are expected here. Tighten it (no
	# 'unsafe-inline', use nonces or hashes) and switch to Content-Security-Policy once a production build exists.
	# `connect-src` includes the Sentry ingest: adjust it to your DSN host.
	handle {
		header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss: https://*.ingest.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy panel:5173
	}
}
