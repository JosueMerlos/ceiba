# macOS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Local environment (real secrets are never committed)
.env
.env.*
!.env.example

# Logs and temp files
*.log
tmp/

# Ruby / Rails (backend)
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/public/assets
/backend/coverage/
/backend/.bundle/

# Node / frontend
node_modules/
dist/
coverage/
*.tsbuildinfo

# Rails credentials master key
/backend/config/*.key

# ticket-harness: local plans, PR state and evidence
.harness/
