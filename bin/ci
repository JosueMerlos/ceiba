#!/usr/bin/env bash
# Runs locally, inside Docker, the same steps as CI (.github/workflows/ci.yml).
# Each CI job calls backend/bin/ci-* or frontend/bin/ci-*; this calls the same scripts in the development containers.
# Runs every stage (even if one fails) and exits non-zero if any failed.
#
#   bin/ci                       # all stages
#   bin/ci backend-test          # only the given ones (CI job names)
#
# The e2e stage brings up the full Compose environment with demo seeds and runs Playwright in its container; on GitHub
# it runs only on `main` (e2e job in ci.yml).
#
# Extra local stages: repo-checks (version consistency, action SHA pins, PR title validator and large-file guard, which
# run inside backend-lint in CI) and workflows (actionlint, pinned Docker image).
set -uo pipefail
cd "$(dirname "$0")/.."

export HOST_UID="${HOST_UID:-$(id -u)}" HOST_GID="${HOST_GID:-$(id -g)}"
ACTIONLINT_IMAGE="rhysd/actionlint:1.7.12"

backend()  { docker compose run --rm --no-deps -T -e RUN_SETUP=false api "$@"; }
# app_owner/app_user roles: idempotent, so it also covers a DB volume created before the roles existed.
db_roles() { docker compose exec -T db /docker-entrypoint-initdb.d/10-roles.sh; }
backend_with_services() { docker compose run --rm -T -e RUN_SETUP=false -e RAILS_ENV=test api "$@"; }
frontend() { docker compose run --rm --no-deps -T --entrypoint "" -w /app/frontend panel "$@"; }

stage_repo_checks() {
  infra/scripts/check-versions.sh && infra/scripts/check-action-pins.sh && infra/scripts/check-pr-title_test.sh \
    && infra/scripts/check-large-files_test.sh && infra/scripts/check-large-files.sh
}
stage_workflows()        { docker run --rm -v "$PWD":/repo -w /repo "$ACTIONLINT_IMAGE"; }
stage_backend_lint()     { backend bin/ci-lint; }
stage_backend_packs()    { infra/scripts/check-package-todo-growth_test.sh && infra/scripts/check-package-todo-growth.sh && backend bin/ci-packs; }
# Tests init-roles.sh on a throwaway database (identity, views, functions, partitions; two runs).
db_roles_test() { docker compose exec -T db env INIT_ROLES=/docker-entrypoint-initdb.d/10-roles.sh bash -s < infra/db/init-roles_test.sh; }
stage_backend_migrations() { docker compose up -d --wait db redis && db_roles && db_roles_test && backend_with_services bin/ci-migrations; }
stage_backend_test()     { docker compose up -d --wait db redis && db_roles && backend_with_services bin/ci-test; }
stage_backend_security() { backend bin/ci-security; }
stage_frontend_lint()    { frontend bin/ci-lint; }
stage_frontend_test()    { frontend bin/ci-test; }
stage_frontend_security() { frontend bin/ci-security; }
# Bundle budgets: critical JS of booking < 150 KiB and of panel < 220 KiB gzip (bundle-budgets.json).
stage_frontend_bundle()  { frontend bin/ci-bundle; }
# E2E: DB roles, full environment (API with seeds, panel, booking, proxy), smoke (infra/scripts/smoke.sh: titles, CSP,
# HMR) and Playwright. Screenshots and report land in frontend/e2e (screenshots, playwright-report, test-results).
stage_e2e() {
  docker compose up -d --wait db redis && db_roles \
    && docker compose up -d --build --wait \
    && infra/scripts/smoke.sh \
    && docker compose run --rm -T -e E2E_SCREENSHOT_DIR=/app/frontend/e2e/screenshots e2e
}
stage_api_contract() {
  infra/scripts/check-api-contract_test.sh && docker compose up -d --wait db redis && db_roles \
    && OPENAPI_GENERATE='docker compose run --rm -T -e RUN_SETUP=false -e RAILS_ENV=test api bin/ci-openapi' \
       CLIENT_GENERATE='docker compose run --rm --no-deps -T --entrypoint "" -w /app/frontend panel bin/ci-api-client' \
       infra/scripts/check-api-contract.sh
}

ALL_STAGES=(repo-checks workflows backend-lint backend-packs backend-migrations backend-test backend-security frontend-lint frontend-test frontend-security frontend-bundle api-contract e2e)
if [ "$#" -gt 0 ]; then stages=("$@"); else stages=("${ALL_STAGES[@]}"); fi

# Build images (layer cache applies) so the containers exist.
docker compose build api panel >/dev/null || { echo "bin/ci: no se pudieron construir las imágenes" >&2; exit 1; }

declare -a results=()
failed=0
started_all=$SECONDS
for stage in "${stages[@]}"; do
  function_name="stage_${stage//-/_}"
  if ! declare -F "$function_name" >/dev/null; then
    echo "bin/ci: etapa desconocida '$stage' (válidas: ${ALL_STAGES[*]})" >&2
    exit 2
  fi
  printf '\n\033[1m== %s ==\033[0m\n' "$stage"
  started=$SECONDS
  if "$function_name"; then status="ok"; else status="FALLA"; failed=1; fi
  results+=("$(printf '%-18s %-6s %4ss' "$stage" "$status" "$((SECONDS - started))")")
done

printf '\n\033[1m== Resumen ==\033[0m\n'
printf '%s\n' "${results[@]}"
printf 'total: %ss\n' "$((SECONDS - started_all))"
exit "$failed"
