#!/usr/bin/env bash
# Regenerates, inside Docker, the OpenAPI contract (backend/openapi/v1.yaml, from the rswag specs) and the TypeScript
# client (frontend/packages/api-client/src/schema.d.ts). Run it after changing an endpoint or serializer and commit the
# result: CI fails if the contract or the client are stale (infra/scripts/check-api-contract.sh).
set -euo pipefail
cd "$(dirname "$0")/.."

export HOST_UID="${HOST_UID:-$(id -u)}" HOST_GID="${HOST_GID:-$(id -g)}"

docker compose up -d --wait db redis
docker compose exec -T db /docker-entrypoint-initdb.d/10-roles.sh
docker compose run --rm -T -e RUN_SETUP=false -e RAILS_ENV=test api bin/ci-openapi
docker compose run --rm --no-deps -T --entrypoint "" -w /app/frontend panel bin/ci-api-client
